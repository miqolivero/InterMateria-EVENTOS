# Copiar a .env dentro de api-eventos. Completar valores locales; no subir .env.
# Iniciar npm run dev o npm start desde esa carpeta.
PORT=3000

# PostgreSQL: la base debe existir y tener el esquema del proyecto.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Si contiene # o espacios, escribir la contraseña entre comillas.
DB_PASSWORD=
DB_NAME=eventos
# Origen exacto del navegador, sin ruta ni barra final (CORS).
FRONT_URL=http://localhost:5173

# Generar una clave propia: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Obligatorio: no dejar vacío. No reutilizar la contraseña de PostgreSQL.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Opcional para npm run db:actualizar: si pg_dump no está en PATH.
# PostgreSQL 18 en Windows se detecta automáticamente.
# PG_DUMP="C:/Program Files/PostgreSQL/18/bin/pg_dump.exe"
